application_name=your_app_name
main_directory_path=/path/to/your/directory
dockerized_container_name=your_docker_container_name

# PostgreSQL Configuration
postgresql_user=postgres_user
postgresql_password=supersecret
postgresql_database=your_database_name
encryption_password=your_encryption_passphrase

# Email Configuration
mailgun_api_key=your_mailgun_key
mailgun_domain=mg.yourdomain.com
sender_email=sender@example.com
email_recipient=recipient@example.com
additional_email_recipient=recipient@example.com

# SMS Configuration
sms_access_key=your_sms_access_key
sms_sender_id=YourSenderID
sms_api_key=your_sms_api_key
sms_client_id=your_sms_client_id
sms_recipient_1=contact_number_1
sms_recipient_2=contact_number_2

# Application URL for Uptime Check
application_url=https://yourapplication.url